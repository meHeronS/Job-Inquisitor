# Job Inquisitor Security (IMPORTANT: We track directories with .gitkeep but ignore files)
# Ignore all files inside user_data, data, and logs, EXCEPT .gitkeep
user_data/*
!user_data/.gitkeep
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
tests/logs/*
!tests/logs/.gitkeep

# Mocks e Datasets Locais de Teste (Não subir massa de dados)
tests/mocks/*.json
