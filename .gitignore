# Node.js dependencies
node_modules/

# Environment & Secrets (NUNCA SUBIR PARA O GITHUB)
.env
.env.local
.env.*.local
credentials.json
secrets.json
*.pem
*.key

# Estrutura de Pastas Privadas (Manter Pastas via .gitkeep no GitHub, Bloquear Conteúdo Privado)
user_data/*
!user_data/**/.gitkeep
!user_data/resumes/
!user_data/letters/
!user_data/sessions/

# Arquivos sensíveis do usuário
*.pdf
*.docx
*.doc

# Banco de Dados Local & Relatórios Gerados pelo Sistema (Manter Pastas via .gitkeep, Bloquear Arquivos)
data/*
!data/**/.gitkeep
!data/db/
!data/reports/

# Logs de Auditoria do Sistema
logs/*
!logs/**/.gitkeep
*.log
npm-debug.log*

# Playwright artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker data persistence (local)
.data/
mongo_data/
redis_data/
