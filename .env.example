# Configurações do Banco de Dados MongoDB
MONGO_URI=mongodb://localhost:27017/job-seek

# Configurações do Redis (BullMQ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Configurações do Servidor / CLI
PORT=3000
NODE_ENV=development

# Configurações do Monitor de E-mails (Multi-Account: Gmail e Outlook)
# ATENÇÃO: NUNCA coloque suas senhas reais neste arquivo .env.example. Use o arquivo .env local!

# Conta 1: Gmail
GMAIL_HOST=imap.gmail.com
GMAIL_PORT=993
GMAIL_USER=seu_usuario@gmail.com
GMAIL_PASS=sua_senha_de_aplicativo_gmail

# Conta 2: Outlook / Hotmail
OUTLOOK_HOST=outlook.office365.com
OUTLOOK_PORT=993
OUTLOOK_USER=seu_usuario@outlook.com
OUTLOOK_PASS=sua_senha_de_aplicativo_outlook
